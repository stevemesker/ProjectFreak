filters:
  and:
    - file.inFolder("Tasks/Design")
    - file.ext == "md"
properties:
  file.name:
    displayName: Task
  note.status:
    displayName: Status
  note.priority:
    displayName: Priority
  note.chapter:
    displayName: Chapter
  note.owner:
    displayName: Owner
  note.needs:
    displayName: Needs
  note.done:
    displayName: Done
  note.archived:
    displayName: Archived
views:
  - type: kanban
    name: By Priority
    filters:
      and:
        - note.status != "Archived"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - To Do
      - In Progress
      - Done
    order:
      - file.name
      - priority
      - chapter
      - owner
      - needs
    sort:
      - property: priority
        direction: ASC
  - type: kanban
    name: By Chapter
    filters:
      and:
        - note.status != "Archived"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - To Do
      - In Progress
      - Done
    order:
      - file.name
      - chapter
      - priority
      - owner
      - needs
    sort:
      - property: chapter
        direction: ASC
      - property: priority
        direction: ASC
  - type: table
    name: Chapter Table
    filters:
      and:
        - note.status != "Archived"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - file.name
      - priority
      - status
      - owner
    sort:
      - property: priority
        direction: ASC
  - type: table
    name: Archive
    filters:
      and:
        - note.status == "Archived"
    order:
      - file.name
      - chapter
      - owner
      - done
      - archived
    sort:
      - property: archived
        direction: DESC
      - property: file.name
        direction: ASC
