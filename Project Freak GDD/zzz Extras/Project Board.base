filters:
  and:
    - file.inFolder("Tasks")
    - file.ext == "md"
properties:
  file.name:
    displayName: Task
  file.folder:
    displayName: Board
  note.status:
    displayName: Status
  note.chapter:
    displayName: Chapter
  note.owner:
    displayName: Owner
  note.done:
    displayName: Done
  note.needs:
    displayName: Needs
views:
  - type: table
    name: In Progress
    filters:
      and:
        - note.status == "In Progress"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - chapter
      - owner
  - type: table
    name: By Chapter
    filters:
      and:
        - note.status != "Done"
        - note.status != "Archived"
    groupBy:
      property: chapter
      direction: ASC
    order:
      - file.name
      - file.folder
      - status
      - owner
  - type: table
    name: Weekly Review
    filters:
      and:
        - note.status == "Done"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - chapter
      - owner
      - done
    sort:
      - property: done
        direction: ASC
  - type: table
    name: Waiting on Something
    filters:
      and:
        - note.status != "Done"
        - note.status != "Archived"
        - "!needs.isEmpty()"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - status
      - needs
      - owner
